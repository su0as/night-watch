# Copy to .env and fill in what you use. Everything is optional except the models you want to run.

# Where training runs are written
NW_RUNS_DIR=runs

# Local vision/text model served by Ollama (https://ollama.com). Gemma 4 E4B reads images.
NW_OLLAMA_URL=http://localhost:11434
# How long Ollama keeps Gemma in memory after a look. On a 16 GB laptop use 2m: Gemma (~6 GB) then
# leaves between 5-minute checks, and TabPFN / the training run get the memory. Empty = Ollama's default.
NW_OLLAMA_KEEP_ALIVE=2m
NW_VISION_MODEL=gemma4:e4b-it-qat
NW_TEXT_MODEL=gemma4:e4b-it-qat
# What Gemma looks at: head (camera bolted to the robot; the default) or side (the usual view, which
# Gemma 4 E4B could not judge in docs/EYETEST.md). Side-view judging options: snapshots, size, thinking.
NW_VISION_VIEW=head
# NW_VISION_THINK=0
# NW_VISION_SNAPSHOTS=2
# NW_VISION_MAX_SIDE=1024

# TabPFN: auto | local | client | sklearn   (sklearn is a fallback for development only)
NW_TABPFN_BACKEND=auto
# v3.5 | v3.5-fast | v3 | v2
NW_TABPFN_VERSION=v3.5
NW_TABPFN_TRAIN_TABLE=models/windows.csv
# The live watcher fits once and keeps TabPFN's cache: ~1 s per check instead of ~96 s on a laptop CPU.
NW_TABPFN_FIT_MODE=fit_with_cache
# Headless TabPFN licence token from https://ux.priorlabs.ai (only if the browser login does not work)
# TABPFN_TOKEN=

# Training and watching ask the OS not to sleep while they run. Set to 1 to allow sleep.
# NW_ALLOW_SLEEP=0

# How often the watcher looks (seconds) and how polite it is
NW_CHECK_EVERY_S=300
NW_MAX_WAKES=3
NW_SNOOZE_MIN=60

# Phone alerts. ntfy needs no account: install the ntfy app and subscribe to your topic.
NW_NTFY_TOPIC=
NW_NTFY_SERVER=https://ntfy.sh
# Or Telegram
NW_TELEGRAM_TOKEN=
NW_TELEGRAM_CHAT_ID=

# Temporal (durable watcher). Start a dev server with: temporal server start-dev --db-filename nightwatch.db
TEMPORAL_ADDRESS=localhost:7233
NW_TASK_QUEUE=night-watch

# Optional: Sentry agent tracing for every Gemma call
SENTRY_DSN=
