# Copy to .env and fill in what you use. Everything is optional except the models you want to run.

# Where training runs are written
NW_RUNS_DIR=runs

# Local vision/text model served by Ollama (https://ollama.com). Gemma 4 E4B reads images.
NW_OLLAMA_URL=http://localhost:11434
NW_VISION_MODEL=gemma4:e4b
NW_TEXT_MODEL=gemma4:e4b

# TabPFN: auto | local | client | sklearn   (sklearn is a fallback for development only)
NW_TABPFN_BACKEND=auto
# v3.5 | v3.5-fast | v3 | v2
NW_TABPFN_VERSION=v3.5
NW_TABPFN_TRAIN_TABLE=models/windows.csv
# Headless TabPFN licence token from https://ux.priorlabs.ai (only if the browser login does not work)
# TABPFN_TOKEN=

# How often the watcher looks (seconds) and how polite it is
NW_CHECK_EVERY_S=300
NW_MAX_WAKES=3
NW_SNOOZE_MIN=60

# Phone alerts. ntfy needs no account: install the ntfy app and subscribe to your topic.
NW_NTFY_TOPIC=
NW_NTFY_SERVER=https://ntfy.sh
# Or Telegram
NW_TELEGRAM_TOKEN=
NW_TELEGRAM_CHAT_ID=

# Temporal (durable watcher). Start a dev server with: temporal server start-dev --db-filename nightwatch.db
TEMPORAL_ADDRESS=localhost:7233
NW_TASK_QUEUE=night-watch

# Optional: Sentry agent tracing for every Gemma call
SENTRY_DSN=
